PORT=5000
JWT_SECRET=student-payment-portal-secret-key-change-in-production

# Google Sheets Configuration (legacy — BigQuery is primary)
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
GOOGLE_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# SSO Configuration (Forms → POST /api/auth/generate-auth-code)
SSO_AUTH_KEY=your-shared-sso-secret-key
# TOKEN_SECRET=your-shared-sso-secret-key

# Production frontend origin used in redirect_url after token mint
# Local: http://localhost:5173
# Production: https://fee-details.nxtwave.academy
FRONTEND_URL=https://fee-details.nxtwave.academy

# Neon Postgres (stores one-time SSO auth tokens)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Keep OFF in production — students must use SSO
# ALLOW_DIRECT_USER_ID_LOGIN=true
